# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# MUST point at a database SEPARATE from cashlo-backend's database.
# Same MongoDB cluster is fine — just a different database name, e.g.:
#   mongodb+srv://user:pass@cluster.mongodb.net/cashlo_cms
# Do NOT reuse cashlo-backend's database name here.
DATABASE_URI=

# Used by cashlo-final to call this CMS's REST/GraphQL API.
NEXT_PUBLIC_SERVER_URL=http://localhost:3300

# Same Cloudflare R2 account/bucket as cashlo-backend (see its .env /
# src/config/environment.js for the actual values) — media uploads here are
# scoped to their own `cms-media/` prefix inside that bucket, so they never
# collide with cashlo-backend's `blogs/` or `distributor/aadhaar/` uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cashlo-media
R2_PUBLIC_URL=